<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>

      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>透明度</string>
        <key>footerText</key>
        <string>数值越小越透明。拉到 0 灵动岛会完全看不见，注意别拉到底。</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>transEnabled</string>
        <key>label</key>
        <string>启用自定义透明度</string>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>不透明度</string>
        <key>default</key>
        <real>1.0</real>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>1.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>alpha</string>
      </dict>

      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>自定义颜色</string>
        <key>footerText</key>
        <string>三项都是 0 时是纯黑，三项都是 1 时是纯白。改完立刻生效。</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>colorEnabled</string>
        <key>label</key>
        <string>启用自定义颜色</string>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>红</string>
        <key>default</key>
        <real>0.0</real>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>1.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>red</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>绿</string>
        <key>default</key>
        <real>0.0</real>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>1.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>green</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>蓝</string>
        <key>default</key>
        <real>0.0</real>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>1.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>blue</string>
      </dict>

      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
      </dict>
      <dict>
        <key>action</key>
        <string>resetColor</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>恢复默认（纯黑 · 不透明）</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
      </dict>

    </array>
    <key>title</key>
    <string>颜色与透明度</string>
  </dict>
</plist>
