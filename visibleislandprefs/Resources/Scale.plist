        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
      </dict>

      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>footerText</key>
        <string>缩放是围绕灵动岛中心做的，所以放大缩小都不会左右偏移，展开动画也保持居中。</string>
