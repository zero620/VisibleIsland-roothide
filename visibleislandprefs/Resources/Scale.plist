<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>

      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>自定义缩放</string>
        <key>footerText</key>
        <string>拖动滑块实时预览，不用注销。1.0 是原始大小，越小灵动岛越小。缩放围绕岛自身中心做，不会因为缩小而偏移。</string>
