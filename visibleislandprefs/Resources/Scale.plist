        <true/>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>scaleEnabled</string>
        <key>label</key>
        <string>启用自定义缩放</string>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>缩放比例</string>
        <key>default</key>
        <real>0.66</real>
        <key>min</key>
        <real>0.6</real>
        <key>max</key>
        <real>1.4</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.ethxnn88.visibleislandprefs-updated</string>
        <key>defaults</key>
        <string>com.ethxnn88.visibleislandprefs</string>
        <key>key</key>
        <string>scale</string>
